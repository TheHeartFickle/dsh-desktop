+  /**
+   * Create the profile in the official shape when it does not exist yet, so callers that write
+   * profile files before the first release start from a valid manifest and workspace.
+   * @param projectDir - Profile directory to create.
+   */
+  async ensureProfileDirectory(projectDir: string): Promise<void> {
+    await this.withLock(async () => {
+      this.descriptor = this.readRuntime()
+      if (!existsSync(join(projectDir, 'package.json'))) createPluginProfile(projectDir)
+    })
+  }
+
+  /**
+   * Make the installed packages match the profile's manifest: rebuild dependencies from scratch and
+   * refresh the reserved host package links. Restoring files from a snapshot, or writing a manifest
+   * outside the official package commands, leaves package state stale in ways `applyRelease` cannot
+   * observe, so the caller uses this instead of that fast path.
+   * @param projectDir - Profile whose configuration files were just written or restored.
+   */
+  async ensureProfilePackages(projectDir: string): Promise<void> {
+    await this.withLock(async () => {
+      this.descriptor = this.readRuntime()
+      if (!existsSync(join(projectDir, 'package.json')) || !existsSync(join(projectDir, 'pnpm-workspace.yaml'))) {
+        throw new Error('desktop project: restored profile is missing its configuration files')
+      }
+      unlinkDesktopHostPackages(projectDir)
+      removeOwnedDirectory(join(projectDir, 'node_modules'))
+      await this.runPnpm(projectDir, ['install', '--ignore-scripts'])
+      await this.finishPackageOperation(projectDir)
+    })
+  }
+
