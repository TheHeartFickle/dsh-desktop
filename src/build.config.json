{
  "upstream": "deepseek-harness",
  "upstreamUrl": "https://github.com/deepseek-ai/deepseek-harness.git",
  "tag": "dsh-v0.1.6-alpha.2",
  "appId": "ai.deepseek.dsh.desktop",
  "releaseEnv": [
    {
      "template": "apps/desktop/.env.windows.example",
      "file": "apps/desktop/.env.windows"
    }
  ],
  "copy": [
    {
      "from": "adaptator",
      "to": "apps/desktop/local/adaptator",
      "exclude": [
        "*.test.mjs",
        "renderer",
        "acl-console-guard.mjs"
      ]
    },
    {
      "from": "adaptator/acl-console-guard.mjs",
      "to": "packages/sandbox/sandbox-windows-acl/acl-console-guard.mjs"
    },
    {
      "from": "features",
      "to": "apps/desktop/local/features",
      "exclude": [
        "*.test.mjs",
        "renderer"
      ]
    },
    {
      "from": "adaptator/renderer/startup-page.js",
      "to": "apps/desktop/renderer/local/startup-page.js"
    },
    {
      "from": "features/renderer/loading-art.js",
      "to": "apps/desktop/renderer/local/loading-art.js"
    },
    {
      "from": "features/renderer/loading-art.css",
      "to": "apps/desktop/renderer/local/loading-art.css"
    },
    {
      "from": "../assets/icon.png",
      "to": "apps/desktop/renderer/local/loading-art.png"
    },
    {
      "from": "../assets/dsh-impact.png",
      "to": "apps/desktop/resources/icon-windows.png"
    }
  ],
  "patches": [
    {
      "file": "patch/project-manager.ts.patch",
      "target": "apps/desktop/src/project-manager.ts"
    },
    {
      "file": "patch/main.ts.patch",
      "target": "apps/desktop/src/main.ts"
    },
    {
      "file": "patch/tsdown.config.ts.patch",
      "target": "apps/desktop/tsdown.config.ts"
    },
    {
      "file": "patch/electron-builder-config.mjs.patch",
      "target": "apps/desktop/scripts/electron-builder-config.mjs"
    },
    {
      "file": "patch/build.ts.patch",
      "target": "scripts/build.ts"
    },
    {
      "file": "patch/prepare-dsh.ts.patch",
      "target": "apps/desktop/scripts/prepare-dsh.ts"
    },
    {
      "file": "patch/package-target.ts.patch",
      "target": "apps/desktop/scripts/package-target.ts"
    },
    {
      "file": "patch/pack.ts.patch",
      "target": "scripts/release/pack.ts"
    },
    {
      "file": "patch/prepare-package-set.ts.patch",
      "target": "apps/desktop/scripts/prepare-package-set.ts"
    },
    {
      "file": "patch/web-document.ts.patch",
      "target": "apps/desktop/src/web-document.ts"
    },
    {
      "file": "patch/preload-menu.ts.patch",
      "target": "apps/desktop/src/preload-menu.ts"
    },
    {
      "file": "patch/locale.ts.patch",
      "target": "apps/desktop/src/locale.ts"
    },
    {
      "file": "patch/main-startup.spec.ts.patch",
      "target": "apps/desktop/tests/main-startup.spec.ts"
    },
    {
      "file": "patch/sandbox-local.ts.patch",
      "target": "packages/sandbox/sandbox-local/src/index.ts"
    },
    {
      "file": "patch/sandbox-local.spec.ts.patch",
      "target": "packages/sandbox/sandbox-local/tests/local.spec.ts"
    },
    {
      "file": "patch/sandbox-windows-acl.package.json.patch",
      "target": "packages/sandbox/sandbox-windows-acl/package.json"
    }
  ],
  "build": [
    {
      "cwd": "apps/desktop",
      "command": [
        "node",
        "--experimental-transform-types",
        "scripts/package-target.ts",
        "win-x64",
        "--dir",
        "--unsigned"
      ],
      "ignoreTargets": [
        "apps/desktop/renderer",
        "apps/desktop/local"
      ],
      "artifacts": {
        "from": "apps/desktop/.desktop-build/targets/win-x64/unsigned-artifacts",
        "to": "release/win-x64"
      },
      "env": {
        "DSH_LOCAL_NPM_REGISTRY": "https://registry.npmmirror.com",
        "ELECTRON_MIRROR": "https://npmmirror.com/mirrors/electron/"
      }
    }
  ]
}
